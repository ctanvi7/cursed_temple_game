{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"exec python -m solara run app.py --host 0.0.0.0 --port ${PORT:-8765}\"",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
